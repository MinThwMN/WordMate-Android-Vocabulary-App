<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/define_dimen_120"
        android:layout_gravity="bottom" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/define_dimen_24"
            android:paddingTop="@dimen/define_dimen_45"
            android:paddingEnd="@dimen/define_dimen_24"
            android:paddingBottom="@dimen/define_dimen_150">

            <TextView
                android:id="@+id/txtLoginTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_app_title"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/define_dimen_8" />

            <TextView
                android:id="@+id/txtLoginSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_subtitle"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_caption"
                android:gravity="center"
                android:layout_marginTop="@dimen/define_dimen_6"
                android:layout_marginBottom="@dimen/define_dimen_10" />

            <LinearLayout
                android:id="@+id/layoutLoginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/define_dimen_18"
                android:paddingTop="@dimen/define_dimen_20"
                android:paddingEnd="@dimen/define_dimen_18"
                android:paddingBottom="@dimen/define_dimen_18">

                <!-- Email input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_56"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_login_input_card">

                    <ImageView
                        android:layout_width="@dimen/define_dimen_22"
                        android:layout_height="@dimen/define_dimen_22"
                        android:layout_marginStart="@dimen/define_dimen_12"
                        android:layout_marginEnd="@dimen/define_dimen_8"
                        android:src="@drawable/ic_email"
                        android:contentDescription="Email"
                        android:scaleType="fitCenter" />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="@string/email"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/gray"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Password input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_56"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_login_input_card"
                    android:layout_marginTop="@dimen/define_dimen_12">

                    <ImageView
                        android:layout_width="@dimen/define_dimen_22"
                        android:layout_height="@dimen/define_dimen_22"
                        android:layout_marginStart="@dimen/define_dimen_12"
                        android:layout_marginEnd="@dimen/define_dimen_8"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="Password"
                        android:scaleType="fitCenter" />

                    <EditText
                        android:id="@+id/edtPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/gray"
                        android:textSize="@dimen/text_body" />

                    <ImageView
                        android:id="@+id/imgTogglePassword"
                        android:layout_width="@dimen/define_dimen_24"
                        android:layout_height="@dimen/define_dimen_24"
                        android:layout_marginStart="@dimen/define_dimen_8"
                        android:layout_marginEnd="@dimen/define_dimen_12"
                        android:src="@drawable/ic_visibility_off"
                        android:contentDescription="Ẩn hiện mật khẩu"
                        android:clickable="true"
                        android:focusable="true"
                        android:scaleType="fitCenter" />

                </LinearLayout>

                <!-- Remember + forgot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="@dimen/define_dimen_14">

                    <TextView
                        android:id="@+id/txtForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_password"
                        android:textColor="@color/primary_blue"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Login button -->
                <TextView
                    android:id="@+id/btnLoginEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_50"
                    android:gravity="center"
                    android:text="@string/login"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_button"
                    android:textStyle="bold"
                    android:background="@drawable/bg_primary_button"
                    android:layout_marginTop="@dimen/define_dimen_20" />

            </LinearLayout>

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/define_dimen_24"
                android:layout_marginBottom="@dimen/define_dimen_18">

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/define_dimen_2"
                    android:layout_weight="1"
                    android:background="@color/light_gray" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/or"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/define_dimen_2"
                    android:layout_weight="1"
                    android:background="@color/light_gray" />

            </LinearLayout>

            <!-- logos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Google -->
                <FrameLayout
                    android:id="@+id/btnLoginGoogle"
                    android:layout_width="@dimen/define_dimen_56"
                    android:layout_height="@dimen/define_dimen_56"
                    android:background="@drawable/bg_google">

                    <ImageView
                        android:layout_width="@dimen/define_dimen_30"
                        android:layout_height="@dimen/define_dimen_30"
                        android:layout_gravity="center"
                        android:src="@drawable/img_google"
                        android:contentDescription="Google"
                        android:scaleType="fitCenter" />

                </FrameLayout>

                <Space
                    android:layout_width="@dimen/define_dimen_20"
                    android:layout_height="@dimen/define_dimen_2" />

                <!-- Facebook -->
                <FrameLayout
                    android:id="@+id/btnLoginFacebookCustom"
                    android:layout_width="@dimen/define_dimen_56"
                    android:layout_height="@dimen/define_dimen_56"
                    android:background="@drawable/bg_facebook_circle">

                    <TextView
                        android:layout_width="@dimen/define_dimen_35"
                        android:layout_height="@dimen/define_dimen_35"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="f"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_app_title"
                        android:textStyle="bold"/>

                </FrameLayout>

            </LinearLayout>

            <!-- Hidden real Facebook SDK button -->
            <com.facebook.login.widget.LoginButton
                android:id="@+id/btnLoginFacebook"
                android:layout_width="@dimen/define_dimen_2"
                android:layout_height="@dimen/define_dimen_2"
                android:visibility="invisible" />

            <!-- Register -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/define_dimen_28">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_account"
                    android:textColor="@color/dark_gray"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/btnRegisterEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register"
                    android:textColor="@color/primary_blue"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>