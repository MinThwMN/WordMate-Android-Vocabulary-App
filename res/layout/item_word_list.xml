<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWordList"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/define_dimen_14"
    card_view:cardBackgroundColor="@color/white"
    card_view:cardCornerRadius="@dimen/define_dimen_18"
    card_view:cardElevation="@dimen/define_dimen_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/define_dimen_80"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_fragment_card"
        android:padding="@dimen/define_dimen_14">

        <ImageView
            android:id="@+id/imgListIcon"
            android:layout_width="@dimen/define_dimen_45"
            android:layout_height="@dimen/define_dimen_45"
            android:src="@drawable/ic_favorite"
            android:background="@drawable/bg_circle_light"
            android:padding="@dimen/define_dimen_10"
            android:contentDescription="List icon"
            card_view:tint="@color/error_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/define_dimen_14">

            <TextView
                android:id="@+id/txtListName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Need Review"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_meaning"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtListCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/number_of_words"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_caption"
                android:layout_marginTop="@dimen/define_dimen_4" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtOpenList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/define_dimen_35"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>