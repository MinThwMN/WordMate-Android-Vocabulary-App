<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main_app"
    android:paddingStart="@dimen/define_dimen_16"
    android:paddingTop="@dimen/define_dimen_16"
    android:paddingEnd="@dimen/define_dimen_16"
    android:paddingBottom="@dimen/define_dimen_16">

    <!-- Header: title bên trái, streak bên phải -->
    <LinearLayout
        android:id="@+id/layoutHomeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/define_dimen_14">

        <!-- Left side -->
        <LinearLayout
            android:id="@+id/layoutHeaderLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtHomeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vocabulary"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_app_title"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Right side: streak -->
        <LinearLayout
            android:id="@+id/layoutStreak"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/define_dimen_45"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="@dimen/define_dimen_12"
            android:paddingEnd="@dimen/define_dimen_12">

            <ImageView
                android:id="@+id/imgStreakIcon"
                android:layout_width="@dimen/define_dimen_30"
                android:layout_height="@dimen/define_dimen_30"
                android:src="@drawable/bg_streak"
                android:scaleType="centerInside"
                android:contentDescription="Streak icon" />

            <TextView
                android:id="@+id/txtStreakCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/define_dimen_4" />

        </LinearLayout>

    </LinearLayout>

    <!-- Topic list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTopics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/define_dimen_16"/>

</LinearLayout>