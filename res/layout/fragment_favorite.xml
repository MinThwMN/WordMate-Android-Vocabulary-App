<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFavorite"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app">

    <LinearLayout
        android:id="@+id/layoutFavoriteContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingTop="@dimen/define_dimen_16"
        android:paddingEnd="@dimen/define_dimen_16"
        android:paddingBottom="@dimen/define_dimen_16">

        <LinearLayout
            android:id="@+id/layoutFavoriteHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/define_dimen_16">

            <ImageView
                android:id="@+id/imgFavoriteBack"
                android:layout_width="@dimen/define_dimen_40"
                android:layout_height="@dimen/define_dimen_40"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_circle_light"
                android:padding="@dimen/define_dimen_8"
                android:contentDescription="Back"
                android:visibility="gone"
                app:tint="@color/dark_navy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/define_dimen_8">

                <TextView
                    android:id="@+id/txtFavoriteTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_word_list"
                    android:textColor="@color/dark_navy"
                    android:textSize="@dimen/text_app_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFavoriteSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite_subtitle"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/text_body"
                    android:layout_marginTop="@dimen/define_dimen_4" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/btnCreateList"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_50"
            android:gravity="center"
            android:text="@string/create_new_list"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_button"
            android:layout_marginBottom="@dimen/define_dimen_16" />

        <TextView
            android:id="@+id/btnStudyListFlashcard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_50"
            android:gravity="center"
            android:text="@string/study_flashcard"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            android:background="@drawable/bg_outline_button"
            android:layout_marginBottom="@dimen/define_dimen_16"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerWordLists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/define_dimen_16" />

    </LinearLayout>

</FrameLayout>