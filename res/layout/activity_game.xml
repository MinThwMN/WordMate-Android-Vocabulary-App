<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingTop="@dimen/define_dimen_24"
        android:paddingEnd="@dimen/define_dimen_16"
        android:paddingBottom="@dimen/define_dimen_40">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/define_dimen_60"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/define_dimen_40"
                android:layout_height="@dimen/define_dimen_40"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/dark_navy"
                android:background="@drawable/bg_circle_light"
                android:padding="@dimen/define_dimen_8"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/define_dimen_12"
                android:layout_marginEnd="@dimen/define_dimen_8">

                <TextView
                    android:id="@+id/txtGameTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/game_quiz"
                    android:textColor="@color/dark_navy"
                    android:textSize="@dimen/text_meaning"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtGameTopic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Travel"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginTop="@dimen/define_dimen_2" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtGameScore"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/define_dimen_35"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:background="@drawable/bg_game_score"
                android:paddingStart="@dimen/define_dimen_14"
                android:paddingEnd="@dimen/define_dimen_14" />

        </LinearLayout>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressGame"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_8"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_topic_home"
            android:layout_marginTop="@dimen/define_dimen_10"
            android:layout_marginBottom="@dimen/define_dimen_10" />

        <TextView
            android:id="@+id/txtGameDetailScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/define_dimen_14"
            android:gravity="center"
            android:text="@string/game_score_default"
            android:textColor="@color/gray"
            android:textSize="@dimen/text_caption" />

        <!-- Main card -->
        <LinearLayout
            android:id="@+id/layoutGameCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_flashcard_card"
            android:padding="@dimen/define_dimen_18">

            <TextView
                android:id="@+id/txtQuestionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/game_question"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_caption"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="airport"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_flashcard_word"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/define_dimen_10"
                android:layout_marginBottom="@dimen/define_dimen_18" />

            <!-- QUIZ -->
            <LinearLayout
                android:id="@+id/layoutQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnAnswerA"
                    style="@style/GameAnswerStyle"
                    android:text="@string/game_quiz_answer1" />

                <TextView
                    android:id="@+id/btnAnswerB"
                    style="@style/GameAnswerStyle"
                    android:text="@string/game_quiz_answer2"
                    android:layout_marginTop="@dimen/define_dimen_10" />

                <TextView
                    android:id="@+id/btnAnswerC"
                    style="@style/GameAnswerStyle"
                    android:text="@string/game_quiz_answer3"
                    android:layout_marginTop="@dimen/define_dimen_10" />

                <TextView
                    android:id="@+id/btnAnswerD"
                    style="@style/GameAnswerStyle"
                    android:text="@string/game_quiz_answer4"
                    android:layout_marginTop="@dimen/define_dimen_10" />

            </LinearLayout>

            <!-- FILL -->
            <LinearLayout
                android:id="@+id/layoutFill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtMaskedWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="a _ r p o r t"
                    android:textColor="@color/primary_blue"
                    android:textSize="@dimen/text_meaning"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/define_dimen_16" />

                <EditText
                    android:id="@+id/edtFillAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_56"
                    android:hint="@string/game_fill_answer"
                    android:singleLine="true"
                    android:background="@drawable/bg_input_box"
                    android:paddingStart="@dimen/define_dimen_16"
                    android:paddingEnd="@dimen/define_dimen_16"
                    android:textColor="@color/dark_navy"
                    android:textColorHint="@color/gray"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/btnCheckFill"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_50"
                    android:gravity="center"
                    android:text="@string/game_fill_button_check"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_button"
                    android:textStyle="bold"
                    android:background="@drawable/bg_primary_button"
                    android:layout_marginTop="@dimen/define_dimen_14" />

            </LinearLayout>

            <!-- MATCH -->
            <LinearLayout
                android:id="@+id/layoutMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutMatchWords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/layoutMatchMeanings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/define_dimen_12" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/btnNextQuestion"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_50"
            android:gravity="center"
            android:text="@string/flashcard_button_next"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_button"
            android:layout_marginTop="@dimen/define_dimen_16" />

    </LinearLayout>

</ScrollView>