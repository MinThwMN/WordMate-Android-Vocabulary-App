<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutDialogChangePassword"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_group_card"
    android:padding="@dimen/define_dimen_24">

    <TextView
        android:id="@+id/txtChangePasswordTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/change_password_title"
        android:textColor="@color/dark_navy"
        android:textSize="@dimen/text_app_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtChangePasswordSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/change_password_subtitle"
        android:textColor="@color/gray"
        android:textSize="@dimen/text_caption"
        android:layout_marginTop="@dimen/define_dimen_6"
        android:layout_marginBottom="@dimen/define_dimen_20" />

    <TextView
        android:id="@+id/txtCurrentPasswordLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/current_password"
        android:textColor="@color/dark_navy"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtCurrentPassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/define_dimen_50"
        android:background="@drawable/bg_login_input_card"
        android:hint="@string/current_password"
        android:inputType="textPassword"
        android:singleLine="true"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingEnd="@dimen/define_dimen_16"
        android:textColor="@color/dark_navy"
        android:textColorHint="@color/gray"
        android:textSize="@dimen/text_body"
        android:layout_marginTop="@dimen/define_dimen_8"
        android:layout_marginBottom="@dimen/define_dimen_16" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_password"
        android:textColor="@color/dark_navy"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtNewPassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/define_dimen_50"
        android:background="@drawable/bg_login_input_card"
        android:hint="@string/new_password"
        android:inputType="textPassword"
        android:singleLine="true"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingEnd="@dimen/define_dimen_16"
        android:textColor="@color/dark_navy"
        android:textColorHint="@color/gray"
        android:textSize="@dimen/text_body"
        android:layout_marginTop="@dimen/define_dimen_8"
        android:layout_marginBottom="@dimen/define_dimen_16" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm_new_password"
        android:textColor="@color/dark_navy"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtConfirmNewPassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/define_dimen_50"
        android:background="@drawable/bg_login_input_card"
        android:hint="@string/confirm_new_password"
        android:inputType="textPassword"
        android:singleLine="true"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingEnd="@dimen/define_dimen_16"
        android:textColor="@color/dark_navy"
        android:textColorHint="@color/gray"
        android:textSize="@dimen/text_body"
        android:layout_marginTop="@dimen/define_dimen_8"
        android:layout_marginBottom="@dimen/define_dimen_20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnChangePasswordCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/define_dimen_50"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            android:background="@drawable/bg_outline_button" />

        <TextView
            android:id="@+id/btnChangePasswordSave"
            android:layout_width="0dp"
            android:layout_height="@dimen/define_dimen_50"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/save"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_button"
            android:layout_marginStart="@dimen/define_dimen_12" />

    </LinearLayout>

</LinearLayout>