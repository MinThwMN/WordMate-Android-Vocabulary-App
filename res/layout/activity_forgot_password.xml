<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/define_dimen_24"
            android:paddingTop="@dimen/define_dimen_45"
            android:paddingEnd="@dimen/define_dimen_24"
            android:paddingBottom="@dimen/define_dimen_40">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/define_dimen_30"
                android:layout_height="@dimen/define_dimen_30"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back"
                android:padding="@dimen/define_dimen_4"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/txtForgotTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_app_title"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/define_dimen_30"
                android:layout_marginBottom="@dimen/define_dimen_28"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/define_dimen_56"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_login_input_card">

                <ImageView
                    android:layout_width="@dimen/define_dimen_22"
                    android:layout_height="@dimen/define_dimen_22"
                    android:layout_marginStart="@dimen/define_dimen_12"
                    android:layout_marginEnd="@dimen/define_dimen_8"
                    android:src="@drawable/ic_email"
                    android:contentDescription="@string/email"
                    android:scaleType="fitCenter" />

                <EditText
                    android:id="@+id/edtResetEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textColor="@color/dark_navy"
                    android:textColorHint="@color/gray"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnSendResetEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/define_dimen_50"
                android:gravity="center"
                android:text="@string/send_reset_email"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button"
                android:textStyle="bold"
                android:background="@drawable/bg_primary_button"
                android:layout_marginTop="@dimen/define_dimen_22" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>