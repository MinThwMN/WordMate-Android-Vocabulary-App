<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFavoriteWord"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/define_dimen_14"
    card_view:cardBackgroundColor="@color/white"
    card_view:cardCornerRadius="@dimen/define_dimen_18"
    card_view:cardElevation="@dimen/define_dimen_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_fragment_card"
        android:padding="@dimen/define_dimen_14">

        <!-- Left content -->
        <LinearLayout
            android:id="@+id/layoutFavoriteWordInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtFavoriteWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="airport"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_meaning"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFavoriteIpa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/ˈeəpɔːt/"
                android:textColor="@color/primary_blue"
                android:textSize="@dimen/text_ipa"
                android:layout_marginTop="@dimen/define_dimen_4" />

            <TextView
                android:id="@+id/txtFavoriteMeaning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sân bay"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_body"
                android:layout_marginTop="@dimen/define_dimen_4" />

        </LinearLayout>

        <!-- Audio button -->
        <ImageView
            android:id="@+id/imgFavoriteAudio"
            android:layout_width="@dimen/define_dimen_45"
            android:layout_height="@dimen/define_dimen_45"
            android:src="@drawable/ic_sound"
            android:background="@drawable/bg_circle_light"
            android:padding="@dimen/define_dimen_10"
            android:contentDescription="Audio"
            android:layout_marginStart="@dimen/define_dimen_8"
            card_view:tint="@color/primary_blue" />

        <!-- Remove favorite button -->
        <ImageView
            android:id="@+id/imgRemoveFavorite"
            android:layout_width="@dimen/define_dimen_45"
            android:layout_height="@dimen/define_dimen_45"
            android:src="@drawable/ic_favorite"
            android:background="@drawable/bg_circle_light"
            android:padding="@dimen/define_dimen_10"
            android:contentDescription="Remove favorite"
            android:layout_marginStart="@dimen/define_dimen_8"
            card_view:tint="@color/error_red" />

    </LinearLayout>

</androidx.cardview.widget.CardView>