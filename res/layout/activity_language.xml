<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutLanguageScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/layoutLanguageRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/define_dimen_24"
        android:paddingTop="@dimen/define_dimen_45"
        android:paddingEnd="@dimen/define_dimen_24"
        android:paddingBottom="@dimen/define_dimen_40">

        <TextView
            android:id="@+id/txtLanguageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_language_title"
            android:textColor="@color/dark_navy"
            android:textSize="@dimen/text_app_title"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtLanguageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_language_subtitle"
            android:textColor="@color/gray"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginTop="@dimen/define_dimen_8"
            android:layout_marginBottom="@dimen/define_dimen_28" />

        <LinearLayout
            android:id="@+id/layoutVietnamese"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_60"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input_card"
            android:paddingStart="@dimen/define_dimen_16"
            android:paddingEnd="@dimen/define_dimen_16"
            android:layout_marginBottom="@dimen/define_dimen_12"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_vietnamese"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutEnglish"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_60"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input_card"
            android:paddingStart="@dimen/define_dimen_16"
            android:paddingEnd="@dimen/define_dimen_16"
            android:layout_marginBottom="@dimen/define_dimen_12"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_english"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutJapanese"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_60"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input_card"
            android:paddingStart="@dimen/define_dimen_16"
            android:paddingEnd="@dimen/define_dimen_16"
            android:layout_marginBottom="@dimen/define_dimen_12"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_japanese"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutKorean"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_60"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input_card"
            android:paddingStart="@dimen/define_dimen_16"
            android:paddingEnd="@dimen/define_dimen_16"
            android:layout_marginBottom="@dimen/define_dimen_12"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_korean"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>