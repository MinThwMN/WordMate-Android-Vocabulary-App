<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="NoBottomNavActiveIndicator">
        <item name="android:color">@color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <style name="GameAnswerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/define_dimen_56</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/define_dimen_16</item>
        <item name="android:paddingEnd">@dimen/define_dimen_16</item>
        <item name="android:textColor">@color/dark_navy</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_game_answer</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerSize">50%</item>
    </style>
 </resources>