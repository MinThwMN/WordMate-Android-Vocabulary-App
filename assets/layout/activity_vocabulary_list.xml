<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutVocabularyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main_app"
    android:paddingTop="@dimen/define_dimen_16">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutVocabularyHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/define_dimen_70"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/define_dimen_14"
        android:layout_marginBottom="@dimen/define_dimen_14"
        android:background="@color/soft_blue">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/define_dimen_40"
            android:layout_height="@dimen/define_dimen_40"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/dark_navy"
            android:background="@drawable/bg_circle_light"
            android:padding="@dimen/define_dimen_8"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/define_dimen_12"
            android:layout_marginEnd="@dimen/define_dimen_8">

            <TextView
                android:id="@+id/txtTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Travel"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_meaning"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtTopicSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/number_of_words"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_caption"
                android:layout_marginTop="@dimen/define_dimen_2" />

        </LinearLayout>

        <!-- Game button -->
        <ImageView
            android:id="@+id/imgGameReview"
            android:layout_width="@dimen/define_dimen_40"
            android:layout_height="@dimen/define_dimen_40"
            android:src="@drawable/ic_game"
            android:background="@drawable/bg_circle_light"
            android:contentDescription="Review game"
            android:layout_marginEnd="@dimen/define_dimen_18"/>

    </LinearLayout>

    <!-- Word list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerWords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingEnd="@dimen/define_dimen_16"
        android:paddingBottom="@dimen/define_dimen_16" />

</LinearLayout>