<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutDailyGoalDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_group_card"
    android:padding="@dimen/define_dimen_24">

    <TextView
        android:id="@+id/txtDailyGoalTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/daily_goal_title"
        android:textColor="@color/dark_navy"
        android:textSize="@dimen/text_app_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDailyGoalMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/daily_goal_message"
        android:textColor="@color/gray"
        android:textSize="@dimen/text_caption"
        android:layout_marginTop="@dimen/define_dimen_6"
        android:layout_marginBottom="@dimen/define_dimen_18" />

    <TextView
        android:id="@+id/txtDailyGoalLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enter_daily_goal_hint"
        android:textColor="@color/dark_navy"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtDailyGoal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/define_dimen_50"
        android:layout_marginTop="@dimen/define_dimen_8"
        android:layout_marginBottom="@dimen/define_dimen_8"
        android:background="@drawable/bg_login_input_card"
        android:gravity="center_vertical"
        android:hint="@string/enter_daily_goal_hint"
        android:inputType="number"
        android:maxLength="3"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingEnd="@dimen/define_dimen_16"
        android:singleLine="true"
        android:textColor="@color/dark_navy"
        android:textColorHint="@color/gray"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/txtDailyGoalNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/daily_goal_note"
        android:textColor="@color/gray"
        android:textSize="@dimen/text_caption"
        android:layout_marginBottom="@dimen/define_dimen_20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelDailyGoal"
            android:layout_width="0dp"
            android:layout_height="@dimen/define_dimen_50"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_button"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/text_button"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveDailyGoal"
            android:layout_width="0dp"
            android:layout_height="@dimen/define_dimen_50"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/define_dimen_12"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="@string/save"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>