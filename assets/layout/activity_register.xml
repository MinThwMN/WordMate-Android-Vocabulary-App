<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/define_dimen_24"
            android:paddingTop="@dimen/define_dimen_45"
            android:paddingEnd="@dimen/define_dimen_24"
            android:paddingBottom="@dimen/define_dimen_120">

            <TextView
                android:id="@+id/txtRegisterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_app_title"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/define_dimen_8" />

            <TextView
                android:id="@+id/txtRegisterSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_subtitle"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_caption"
                android:gravity="center"
                android:layout_marginTop="@dimen/define_dimen_6"
                android:layout_marginBottom="@dimen/define_dimen_10" />

            <LinearLayout
                android:id="@+id/layoutRegisterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/define_dimen_18"
                android:paddingTop="@dimen/define_dimen_20"
                android:paddingEnd="@dimen/define_dimen_18"
                android:paddingBottom="@dimen/define_dimen_18">

                <!-- Name input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_56"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_login_input_card">

                    <ImageView
                        android:layout_width="@dimen/define_dimen_22"
                        android:layout_height="@dimen/define_dimen_22"
                        android:layout_marginStart="@dimen/define_dimen_12"
                        android:layout_marginEnd="@dimen/define_dimen_8"
                        android:src="@drawable/ic_user"
                        android:contentDescription="Name"
                        android:scaleType="fitCenter" />

                    <EditText
                        android:id="@+id/edtRegisterName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="@string/register_name"
                        android:inputType="textPersonName"
                        android:singleLine="true"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/gray"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Email input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_56"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_login_input_card"
                    android:layout_marginTop="@dimen/define_dimen_12">

                    <ImageView
                        android:layout_width="@dimen/define_dimen_22"
                        android:layout_height="@dimen/define_dimen_22"
                        android:layout_marginStart="@dimen/define_dimen_12"
                        android:layout_marginEnd="@dimen/define_dimen_8"
                        android:src="@drawable/ic_email"
                        android:contentDescription="Email"
                        android:scaleType="fitCenter" />

                    <EditText
                        android:id="@+id/edtRegisterEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="@string/email"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/gray"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Password input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_56"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_login_input_card"
                    android:layout_marginTop="@dimen/define_dimen_12">

                    <ImageView
                        android:layout_width="@dimen/define_dimen_22"
                        android:layout_height="@dimen/define_dimen_22"
                        android:layout_marginStart="@dimen/define_dimen_12"
                        android:layout_marginEnd="@dimen/define_dimen_8"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="Password"
                        android:scaleType="fitCenter" />

                    <EditText
                        android:id="@+id/edtRegisterPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/gray"
                        android:textSize="@dimen/text_body" />

                    <ImageView
                        android:id="@+id/imgToggleRegisterPassword"
                        android:layout_width="@dimen/define_dimen_24"
                        android:layout_height="@dimen/define_dimen_24"
                        android:layout_marginStart="@dimen/define_dimen_8"
                        android:layout_marginEnd="@dimen/define_dimen_12"
                        android:src="@drawable/ic_visibility_off"
                        android:contentDescription="Ẩn hiện mật khẩu"
                        android:clickable="true"
                        android:focusable="true"
                        android:scaleType="fitCenter" />

                </LinearLayout>

                <!-- Confirm password input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_56"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_login_input_card"
                    android:layout_marginTop="@dimen/define_dimen_12">

                    <ImageView
                        android:layout_width="@dimen/define_dimen_22"
                        android:layout_height="@dimen/define_dimen_22"
                        android:layout_marginStart="@dimen/define_dimen_12"
                        android:layout_marginEnd="@dimen/define_dimen_8"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="Confirm Password"
                        android:scaleType="fitCenter" />

                    <EditText
                        android:id="@+id/edtRegisterConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="@string/register_confirm_password"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/gray"
                        android:textSize="@dimen/text_body" />

                    <ImageView
                        android:id="@+id/imgToggleRegisterConfirmPassword"
                        android:layout_width="@dimen/define_dimen_24"
                        android:layout_height="@dimen/define_dimen_24"
                        android:layout_marginStart="@dimen/define_dimen_8"
                        android:layout_marginEnd="@dimen/define_dimen_12"
                        android:src="@drawable/ic_visibility_off"
                        android:contentDescription="Ẩn hiện mật khẩu"
                        android:clickable="true"
                        android:focusable="true"
                        android:scaleType="fitCenter" />

                </LinearLayout>

                <!-- Register button -->
                <TextView
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_50"
                    android:gravity="center"
                    android:text="@string/register"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_button"
                    android:textStyle="bold"
                    android:background="@drawable/bg_primary_button"
                    android:layout_marginTop="@dimen/define_dimen_22" />

            </LinearLayout>

            <!-- Back to login -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/define_dimen_24">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/have_account"
                    android:textColor="@color/dark_gray"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/btnGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login"
                    android:textColor="@color/primary_blue"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>