<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFlashcard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/layoutFlashcardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/soft_blue"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingEnd="@dimen/define_dimen_16"
        android:paddingTop="@dimen/define_dimen_16"
        android:paddingBottom="@dimen/define_dimen_16">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/layoutFlashcardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/define_dimen_60"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/define_dimen_40"
                android:layout_height="@dimen/define_dimen_40"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/dark_navy"
                android:background="@drawable/bg_circle_light"
                android:padding="@dimen/define_dimen_8"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/define_dimen_12"
                android:layout_marginEnd="@dimen/define_dimen_8">

                <TextView
                    android:id="@+id/txtFlashcardTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Travel"
                    android:textColor="@color/dark_navy"
                    android:textSize="@dimen/text_meaning"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtFlashcardCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 5"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginTop="@dimen/define_dimen_2" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imgGameReview"
                android:layout_width="@dimen/define_dimen_40"
                android:layout_height="@dimen/define_dimen_40"
                android:src="@drawable/ic_game"
                android:background="@drawable/bg_circle_light"
                android:contentDescription="Review game" />

        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressFlashcard"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_8"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_topic_home"
            android:layout_marginBottom="@dimen/define_dimen_16" />

        <!-- Flashcard -->
        <LinearLayout
            android:id="@+id/layoutFlashcard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="@dimen/define_dimen_300"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_flashcard_card"
            android:padding="@dimen/define_dimen_20">

            <TextView
                android:id="@+id/txtWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="airport"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_flashcard_word"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtIpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="/ˈeəpɔːt/"
                android:textColor="@color/primary_blue"
                android:textSize="@dimen/text_ipa"
                android:gravity="center"
                android:layout_marginTop="@dimen/define_dimen_10" />

            <TextView
                android:id="@+id/txtMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="sân bay"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_meaning"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/define_dimen_24"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtExample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We arrived at the airport early."
                android:textColor="@color/gray"
                android:textSize="@dimen/text_body"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/define_dimen_4"
                android:layout_marginTop="@dimen/define_dimen_12"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/define_dimen_16">

            <ImageView
                android:id="@+id/imgAudio"
                android:layout_width="@dimen/define_dimen_50"
                android:layout_height="@dimen/define_dimen_50"
                android:src="@drawable/ic_sound"
                app:tint="@color/primary_blue"
                android:background="@drawable/bg_circle_white"
                android:padding="@dimen/define_dimen_12"
                android:contentDescription="Audio" />

            <ImageView
                android:id="@+id/imgShuffle"
                android:layout_width="@dimen/define_dimen_50"
                android:layout_height="@dimen/define_dimen_50"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/primary_blue"
                android:background="@drawable/bg_circle_white"
                android:padding="@dimen/define_dimen_12"
                android:layout_marginStart="@dimen/define_dimen_16"
                android:contentDescription="Shuffle flashcards" />

            <ImageView
                android:id="@+id/imgFavorite"
                android:layout_width="@dimen/define_dimen_50"
                android:layout_height="@dimen/define_dimen_50"
                android:src="@drawable/ic_favorite"
                app:tint="@color/gray"
                android:background="@drawable/bg_circle_white"
                android:padding="@dimen/define_dimen_12"
                android:layout_marginStart="@dimen/define_dimen_16"
                android:contentDescription="Favorite" />

            <ImageView
                android:id="@+id/imgLearned"
                android:layout_width="@dimen/define_dimen_50"
                android:layout_height="@dimen/define_dimen_50"
                android:src="@drawable/ic_check"
                app:tint="@color/success_green"
                android:background="@drawable/bg_circle_white"
                android:padding="@dimen/define_dimen_12"
                android:layout_marginStart="@dimen/define_dimen_16"
                android:contentDescription="Mark learned" />

        </LinearLayout>

        <!-- Navigation buttons -->
        <LinearLayout
            android:id="@+id/layoutNavigationButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="@dimen/define_dimen_16"
            android:layout_marginBottom="@dimen/define_dimen_20">

            <TextView
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="@dimen/define_dimen_50"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/flashcard_button_previous"
                android:textColor="@color/primary_blue"
                android:textSize="@dimen/text_button"
                android:textStyle="bold"
                android:background="@drawable/bg_outline_button" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="@dimen/define_dimen_50"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/flashcard_button_next"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button"
                android:textStyle="bold"
                android:background="@drawable/bg_primary_button"
                android:layout_marginStart="@dimen/define_dimen_12" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>