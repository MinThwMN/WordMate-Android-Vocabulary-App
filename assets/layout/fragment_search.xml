<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSearch"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app">

    <LinearLayout
        android:id="@+id/layoutSearchContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingTop="@dimen/define_dimen_16"
        android:paddingEnd="@dimen/define_dimen_16"
        android:paddingBottom="@dimen/define_dimen_16">

        <!-- Search box -->
        <LinearLayout
            android:id="@+id/layoutSearchBox"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_56"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_box"
            android:paddingStart="@dimen/define_dimen_16"
            android:paddingEnd="@dimen/define_dimen_8"
            android:layout_marginTop="@dimen/define_dimen_16">

            <EditText
                android:id="@+id/edtSearchWord"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/transparent"
                android:hint="@string/hint_enter_word"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/dark_navy"
                android:textColorHint="@color/gray"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:id="@+id/imgSearchIcon"
                android:layout_width="@dimen/define_dimen_40"
                android:layout_height="@dimen/define_dimen_40"
                android:src="@drawable/ic_search"
                android:tint="@color/white"
                android:background="@drawable/bg_search_icon"
                android:padding="@dimen/define_dimen_8"
                android:contentDescription="Search icon" />

        </LinearLayout>

        <!-- Suggestions -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@drawable/bg_fragment_card"
            android:clipToPadding="false"
            android:paddingTop="@dimen/define_dimen_8"
            android:paddingBottom="@dimen/define_dimen_8"
            android:layout_marginTop="@dimen/define_dimen_8" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressSearchLoading"
            android:layout_width="@dimen/define_dimen_40"
            android:layout_height="@dimen/define_dimen_40"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/define_dimen_16"
            android:visibility="gone" />

        <!-- Message / error -->
        <TextView
            android:id="@+id/txtSearchMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_result_found"
            android:textColor="@color/error_red"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginTop="@dimen/define_dimen_16"
            android:visibility="gone" />

        <!-- Result card -->
        <LinearLayout
            android:id="@+id/layoutSearchResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_fragment_card"
            android:padding="@dimen/define_dimen_16"
            android:layout_marginTop="@dimen/define_dimen_16"
            android:visibility="gone">

            <!-- Word + audio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtSearchWord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Word result"
                        android:textColor="@color/dark_navy"
                        android:textSize="@dimen/text_meaning"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSearchIpa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ pronunciation /"
                        android:textColor="@color/primary_blue"
                        android:textSize="@dimen/text_ipa"
                        android:layout_marginTop="@dimen/define_dimen_4" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgAudio"
                        android:layout_width="@dimen/define_dimen_45"
                        android:layout_height="@dimen/define_dimen_45"
                        android:src="@drawable/ic_sound"
                        android:background="@drawable/bg_circle_light"
                        android:padding="@dimen/define_dimen_10"
                        android:contentDescription="Audio"
                        app:tint="@color/primary_blue" />

                    <ImageView
                        android:id="@+id/imgSearchFavorite"
                        android:layout_width="@dimen/define_dimen_45"
                        android:layout_height="@dimen/define_dimen_45"
                        android:src="@drawable/ic_favorite"
                        android:background="@drawable/bg_circle_light"
                        android:padding="@dimen/define_dimen_10"
                        android:layout_marginStart="@dimen/define_dimen_8"
                        android:contentDescription="Save word"
                        app:tint="@color/gray" />

                </LinearLayout>

            </LinearLayout>

            <!-- Meaning -->
            <TextView
                android:id="@+id/txtSearchMeaningTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meaning"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/define_dimen_16" />

            <TextView
                android:id="@+id/txtSearchDefinition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Definition will appear here."
                android:textColor="@color/dark_gray"
                android:textSize="@dimen/text_body"
                android:layout_marginTop="@dimen/define_dimen_6" />

            <!-- Example -->
            <TextView
                android:id="@+id/txtSearchExampleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/example"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/define_dimen_16" />

            <TextView
                android:id="@+id/txtSearchExample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Example sentence will appear here."
                android:textColor="@color/gray"
                android:textSize="@dimen/text_body"
                android:layout_marginTop="@dimen/define_dimen_6" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>