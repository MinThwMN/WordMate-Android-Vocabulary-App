<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootInfoPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/layoutInfoContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingTop="@dimen/define_dimen_16"
        android:paddingEnd="@dimen/define_dimen_16"
        android:paddingBottom="@dimen/define_dimen_30">

        <TextView
            android:id="@+id/txtInfoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terms_of_service"
            android:textColor="@color/dark_navy"
            android:textSize="@dimen/text_app_title"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/define_dimen_16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_fragment_card"
            android:padding="@dimen/define_dimen_18">

            <TextView
                android:id="@+id/txtInfoContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/content"
                android:textColor="@color/dark_gray"
                android:textSize="@dimen/text_body"
                android:singleLine="false"
                android:lineSpacingExtra="@dimen/define_dimen_6" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>