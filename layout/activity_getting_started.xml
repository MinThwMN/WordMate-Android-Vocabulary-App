<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutGettingStartedScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_app"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/layoutGettingStartedRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/define_dimen_24"
        android:paddingTop="@dimen/define_dimen_45"
        android:paddingEnd="@dimen/define_dimen_24"
        android:paddingBottom="@dimen/define_dimen_40">

        <ImageView
            android:id="@+id/imgGettingStartedLogo"
            android:layout_width="@dimen/define_dimen_90"
            android:layout_height="@dimen/define_dimen_90"
            android:layout_gravity="center_horizontal"
            android:src="@mipmap/ic_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/txtGettingStartedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/getting_started_title"
            android:textColor="@color/dark_navy"
            android:textSize="@dimen/text_app_title"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="@dimen/define_dimen_22" />

        <TextView
            android:id="@+id/txtGettingStartedSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/getting_started_subtitle"
            android:textColor="@color/gray"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginTop="@dimen/define_dimen_8"
            android:layout_marginBottom="@dimen/define_dimen_24" />

        <LinearLayout
            android:id="@+id/layoutFeatureTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_fragment_card"
            android:padding="@dimen/define_dimen_18"
            android:layout_marginBottom="@dimen/define_dimen_14">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_topic_title"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_topic_desc"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_caption"
                android:layout_marginTop="@dimen/define_dimen_6" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFeaturePractice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_fragment_card"
            android:padding="@dimen/define_dimen_18"
            android:layout_marginBottom="@dimen/define_dimen_14">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_practice_title"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_practice_desc"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_caption"
                android:layout_marginTop="@dimen/define_dimen_6" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFeatureProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_fragment_card"
            android:padding="@dimen/define_dimen_18"
            android:layout_marginBottom="@dimen/define_dimen_26">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_progress_title"
                android:textColor="@color/dark_navy"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_progress_desc"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_caption"
                android:layout_marginTop="@dimen/define_dimen_6" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_50"
            android:gravity="center"
            android:text="@string/get_started"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>