<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTopicHome"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/define_dimen_14"
    card_view:cardBackgroundColor="@color/white"
    card_view:cardCornerRadius="@dimen/define_dimen_18"
    card_view:cardElevation="@dimen/define_dimen_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/define_dimen_90"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_topic_card"
        android:padding="@dimen/define_dimen_14">

        <!-- Topic Icon -->
        <FrameLayout
            android:id="@+id/layoutTopicIcon"
            android:layout_width="@dimen/define_dimen_56"
            android:layout_height="@dimen/define_dimen_56">

            <ImageView
                android:id="@+id/imgTopicIcon"
                android:layout_width="@dimen/define_dimen_56"
                android:layout_height="@dimen/define_dimen_56"
                android:layout_gravity="center"
                android:src="@drawable/img_topic_default"
                android:scaleType="centerInside"
                android:contentDescription="Topic icon" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtTopicName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Travel"
            android:textColor="@color/dark_navy"
            android:textSize="@dimen/text_meaning"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/define_dimen_14"
            android:layout_marginEnd="@dimen/define_dimen_10" />

        <FrameLayout
            android:id="@+id/layoutTopicProgress"
            android:layout_width="@dimen/define_dimen_60"
            android:layout_height="@dimen/define_dimen_60">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressTopicCircle"
                android:layout_width="@dimen/define_dimen_60"
                android:layout_height="@dimen/define_dimen_60"
                android:layout_gravity="center"
                android:max="100"
                android:progress="0"
                app:indicatorColor="@color/primary_blue"
                app:indicatorSize="@dimen/define_dimen_56"
                app:trackColor="@color/light_gray"
                app:trackThickness="@dimen/define_dimen_5" />

            <TextView
                android:id="@+id/txtTopicProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="0%"
                android:textColor="@color/primary_blue"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

        </FrameLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>